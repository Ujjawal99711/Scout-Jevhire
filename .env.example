# Copy to .env and fill in locally. Never commit .env.

# ConnectSafely — LinkedIn post search (required for live CLI)
CONNECTSAFELY_API_KEY=replace-with-your-connectsafely-api-key
CONNECTSAFELY_BASE_URL=https://api.connectsafely.ai
CONNECTSAFELY_TIMEOUT_SECONDS=90
CONNECTSAFELY_DEFAULT_COUNT=20

# TypeSafe / OpenRouter — Jev hiring judge (required)
TYPESAFE_API_KEY=replace-with-your-typesafe-or-openrouter-api-key
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_TIMEOUT_SECONDS=30
JEV_MODEL=jev-latest
JEV_HIRING_THRESHOLD=0.75

# OpenAI — structured field extraction (required for live CLI)
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5-mini
